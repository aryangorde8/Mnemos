# Mnemos AWS deployment env — copy to .env next to docker-compose.yml and fill in.
# All three below are REQUIRED.

# MongoDB Atlas connection string (free M0 cluster works).
MONGODB_URI=

# Groq API key — free at https://console.groq.com/keys
GROQ_API_KEY=

# Cohere API key (trial key is free) — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# ── Optional overrides (defaults shown) ─────────────────────────────────────
# MONGODB_DB=mnemos
# MONGODB_VECTOR_INDEX=mnemos_vector_index
# MONGODB_TEXT_INDEX=mnemos_text_index
# LLM_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible endpoint
# LLM_MODEL=llama-3.3-70b-versatile
# COHERE_EMBED_MODEL=embed-english-v3.0
# EMBEDDING_DIM=1024                            # must match the Atlas vector index

# ── Optional integrations (leave unset: Gmail/Calendar run simulated,
#    Firebase auth stays open) ────────────────────────────────────────────────
# FIREBASE_PROJECT_ID=
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=
